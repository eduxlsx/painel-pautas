# PautaFlow Intelligence — variáveis de ambiente (opcionais)
# Copie para .env e ajuste. Nenhuma credencial deve ser colocada aqui:
# tokens Microsoft e chaves de IA são cifrados com DPAPI (Windows) em data/secure/.

# Porta HTTP local (padrão 3000)
PAUTAFLOW_PORT=3000

# Interface de rede. Mantenha 127.0.0.1 para não expor a aplicação na rede.
PAUTAFLOW_HOST=127.0.0.1

# Diretório raiz dos dados (padrão: pasta do projeto). data/, backups/ e logs/ ficam abaixo dele.
# PAUTAFLOW_HOME=C:\Users\voce\PautaFlow

# Nível de log: trace | debug | info | warn | error
PAUTAFLOW_LOG_LEVEL=info

# Discord (opcional) — bot para visualizar e gerenciar pautas.
# Vazio = bot desativado. Este é o único segredo mantido no .env (arquivo ignorado pelo Git).
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_PAUTAS=
DISCORD_CHANNEL_GERAL=
DISCORD_CHANNEL_PAINEL=
DISCORD_CHANNEL_LOGS=
# IDs autorizados a gerenciar pautas (vírgula). Vazio = somente o dono do servidor.
DISCORD_ALLOWED_USER_IDS=
DISCORD_ENABLED=true
